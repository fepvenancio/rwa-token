{
  "name": "rwaToken",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "fmt:check": "forge fmt --check contracts",
    "lint:sol": "solhint --max-warnings 0 'contracts/**/*.sol'",
    "test": "hardhat test",
    "test:halmos": "halmos --forge-build-out forge-out --match-contract 'Halmos$' --solver-timeout-assertion 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "3.1.9",
    "@nomicfoundation/hardhat-keystore": "3.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@types/node": "22.20.5",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "3.20.0",
    "solhint-community": "4.0.1",
    "typescript": "6.0.3",
    "viem": "2.57.7"
  }
}
